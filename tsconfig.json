{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "vite.config.ts", "e2e", "playwright.config.ts"],
  // iCloud/macOS sync-conflict copies ("name 2.ts") are never part of the app
  "exclude": ["**/* 2.*", "**/* 3.*", "**/* 4.*", "**/* 5.*", "**/* 6.*", "**/* 7.*", "**/* 8.*", "**/* 9.*", "node_modules", "dist"]
}
